{
  "name": "@payghaam/web",
  "version": "0.1.0",
  "description": "Payghaam SDK for the web \u2014 browser push over the Web Push Protocol, identity, tags, and events.",
  "license": "MIT",
  "author": "Payghaam <dev@payghaam.com>",
  "homepage": "https://github.com/Payghaam/payghaam-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Payghaam/payghaam-web.git"
  },
  "bugs": {
    "url": "https://github.com/Payghaam/payghaam-web/issues"
  },
  "keywords": [
    "web-push",
    "push-notifications",
    "service-worker",
    "vapid",
    "analytics",
    "engagement",
    "payghaam"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./service-worker": "./sw/payghaam-sw.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "sw",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
